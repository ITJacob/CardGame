    {
      "id": "nightfall",
      "name": "夜色",
      "category": [
        "buff"
      ],
      "dispelable": false,
      "duration": null,
      "maxStacks": 3,
      "stackPolicy": "stack",
      "statPerStack": {
        "gauge.rate": 1.5,
        "energy_regen": 0.08
      },
      "triggers": [
        {
          "event": "on_tick",
          "effects": [
            {
              "op": "if",
              "condition": {
                "kind": "phase_is",
                "phases": [
                  "dawn",
                  "day",
                  "dusk"
                ]
              },
              "then": [
                {
                  "op": "if",
                  "condition": {
                    "kind": "has_status",
                    "side": "self",
                    "id": "nightfall",
                    "cmp": ">=",
                    "n": 1
                  },
                  "then": [
                    {
                      "type": "mount_status",
                      "statusId": "nightfall",
                      "stacks": -1,
                      "stackMode": "consume",
                      "target": "self",
                      "note": "倾泻：消耗 1 层夜色"
                    },
                    {
                      "type": "advance_clock",
                      "ticks": 4,
                      "note": "赶夜：花 1 层夜色推进战场时钟 4 tick，抵夜即停"
                    },
                    {
                      "type": "mount_status",
                      "statusId": "night_release_ward",
                      "duration": 4,
                      "target": "self",
                      "note": "倾泻伴生护持（4tick）"
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            }
          ],
          "note": "非夜相位（黎明/白昼/黄昏）逐层倾泻赶夜；产层由『夜色渐浓』相位事件与『黑夜领域』降临驱动"
        }
      ],
      "note": "夜晚专属层数资源：进入夜晚 +1 层、进入午夜或『黑夜领域』降临 +2 层（上限 3 层，每层行动条速率 +1.5、能量回复 +0.08）；非夜相位每 tick 花 1 层推进战场时钟 4 tick（赶夜），并获夜释之护 4tick，时钟抵夜即停。枢纽状态；药师（黑暗之翼、血月当空）读取层数。",
      "crossPathway": true,
      "participants": [
        "sleepless",
        "apothecary"
      ]
    },
