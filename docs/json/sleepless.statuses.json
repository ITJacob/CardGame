    {
      "id": "nightfall",
      "name": "夜色",
      "category": [
        "buff"
      ],
      "dispelable": false,
      "duration": null,
      "maxStacks": 3,
      "stackPolicy": "stack",
      "statPerStack": {
        "gauge.rate": 1,
        "energy_regen": 0.04
      },
      "note": "贮存型层数资源，由『夜色渐浓』单卡自洽管理：夜相位积累（上限 3 层，对齐全库层数观测带中位 1 / 范围 1–3）；光照 >2 时逐层释放——花 1 层把战场光照强制压为 2 覆盖 4tick，覆盖到期且仍有夜色则再花 1 层续 4tick（1 层 = 4tick 暗夜，3 层全放 = 12tick 总覆盖）。每层 gauge.rate +1 / energy_regen +0.04：满层 +3 速率落「常驻轻加速 ≤+5」合规档（≥+10 须挂代价，此状态零代价，故不得上调）。枢纽状态（ddd §1.4）；读取层数者：药师（黑暗之翼、血月当空，均取 >=1，上限收缩不影响）。",
      "crossPathway": true,
      "participants": [
        "sleepless",
        "apothecary"
      ]
    },
