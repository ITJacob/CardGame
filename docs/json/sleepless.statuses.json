    {
      "id": "nightfall",
      "name": "夜色",
      "category": [
        "buff"
      ],
      "dispelable": false,
      "duration": null,
      "maxStacks": 3,
      "stackPolicy": "stack",
      "statPerStack": {
        "gauge.rate": 1,
        "energy_regen": 0.04
      },
      "triggers": [
        {
          "event": "on_tick",
          "effects": [
            {
              "op": "if",
              "condition": {
                "kind": "phase_is",
                "phases": [
                  "dawn",
                  "day",
                  "dusk"
                ]
              },
              "then": [
                {
                  "op": "if",
                  "condition": {
                    "kind": "has_status",
                    "side": "self",
                    "id": "nightfall",
                    "cmp": ">=",
                    "n": 1
                  },
                  "then": [
                    {
                      "type": "mount_status",
                      "statusId": "nightfall",
                      "stacks": -1,
                      "stackMode": "consume",
                      "target": "self",
                      "note": "倾泻：花 1 层夜色（一层一层放，每层买 4tick）"
                    },
                    {
                      "type": "advance_clock",
                      "ticks": 4,
                      "note": "赶夜：花 1 层夜色推进战场时钟 4 tick，抵夜即停"
                    },
                    {
                      "type": "mount_status",
                      "statusId": "night_release_ward",
                      "duration": 4,
                      "target": "self",
                      "note": "倾泻伴生护持（4tick）"
                    }
                  ],
                  "else": []
                }
              ],
              "else": []
            }
          ],
          "note": "非夜相位（黎明/白昼/黄昏）逐层倾泻赶夜；积累由『夜色渐浓』驱动"
        }
      ],
      "note": "夜晚专属层数资源：夜晚/午夜相位或『黑夜领域』存续期每 tick +1（上限 3 层，每层行动条速率 +1、能量回复 +0.04；『黑夜领域』自身不产夜色，须夜色渐浓在场）；非夜相位每 tick 花 1 层推进战场时钟 4 tick（赶夜），并获夜释之护 4tick，时钟抵夜即停。枢纽状态；药师（黑暗之翼、血月当空）读取层数。",
      "crossPathway": true,
      "participants": [
        "sleepless",
        "apothecary"
      ]
    },
