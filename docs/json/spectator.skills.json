      "id": "skill_spectator_s9_subtle_observe",
      "name": "观众·细微观察",
      "kind": "passive",
      "sequence": 9,
      "sequenceName": "观众",
      "rarity": "common",
      "axis": "insight",
      "flagship": false,
      "lore": "序列9 观众 —— \"出众的精神和敏锐的观察力：从表情举止窥见真实想法\"",
      "flavor": "你看着它的肩膀、它的呼吸、它眨眼的方式——每读懂一次，你心里就多记下一笔。",
      "describe": "自身造成精神伤害时，「心象」层数 +1（上限 5 层，整场持续）。",
      "hook": "on_deal_damage",
      "effects": [
        {
          "type": "mount_status",
          "statusId": "insight",
          "stacks": 1,
          "stackMode": "add",
          "target": "self"
        }
      ],
      "tentative": true,
      "frameworkFlags": [
        {
          "code": "DAMAGE_ELEMENT_TRIGGER_FILTER",
          "note": "触发需按伤害元素过滤（仅 mental 伤害时 +1 层），ddd 触发条件侧无元素维度谓词，维持 🟡（本稿新增项 18）",
          "landed": false
        }
      ],
      "conversionNotes": "翻译/语义：\"从表情举止窥见真实想法\"无隐藏信息可看，唯一可落地的语义是\"看懂了就能用\"→ 计数燃料。依赖 H11 + F51。数值 ⚠️D。",
      "triggers": [
        {
          "event": "on_deal_damage",
          "condition": {
            "kind": "element_is",
            "element": [
              "mental"
            ],
            "note": "⚠️D 待定：按元素过滤的清单尚未拍板，暂以 mental 为占位；机制由 condition.kind=element_is 承载（共享内核参数 §三）"
          },
          "effects": [
            {
              "type": "mount_status",
              "statusId": "insight",
              "stacks": 1,
              "stackMode": "add",
              "target": "self"
            }
          ],
          "note": "观众·细微观察：仅当造成伤害的元素匹配时才累积洞察（PENDING 观众 on_deal_damage 按元素过滤）。"
        }
      ]
    },
