        "stacks": 2,
        "effects": [
          {
            "type": "modify_stat",
            "stat": "defense",
            "value": 1,
            "mode": "delta",
            "duration": null,
            "target": "self",
            "note": "⚠️D 占位：payoff 强度待平衡期逐条审批（enabler→payoff 接线）"
