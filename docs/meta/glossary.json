        "drain": { "zh": "汲取", "brief": "从目标吸取资源并按比例回复自身", "detail": "resource ∈ hp/energy，healRatio 控制回复比例。" },
        "domain": { "zh": "界域", "brief": "展开/替换战场界域", "detail": "界域三件套 DomainDef→Grant→Instance。op: overlay(叠加)/swap(置换)/hero(英雄级)。" },
        "translocate": { "zh": "跨层位移", "brief": "目标暂时离场，到期回归", "detail": "op: pull_into(拉入)/banish(放逐)。离场期间 detached：不持坐标、计时冻结，到期于己方队尾回归；banish 可带回归载荷。" },
        "modify_damage": { "zh": "修正伤害", "brief": "修改一次伤害结算的系数", "detail": "scope: taken(承伤)/dealt(造成伤害)，配合 mul。" },
