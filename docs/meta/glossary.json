        "reveal": { "zh": "揭示", "brief": "使隐匿单位显形", "detail": "scope: to_source/to_all。纯驱散隐匿仍用 dispel(category=conceal)，本原语用于「显形但不驱散」。" },
        "grant_immunity": { "zh": "授予免疫", "brief": "授予临时/条件性免疫", "detail": "against(statusCategory[]) × element × charges × duration。" },
        "take_control": { "zh": "夺取控制", "brief": "持续期内目标视为己方行动", "detail": "onExpire: revert(还原)/die(死亡)/keep(保留)；actionPolicy: full/attack_only/move_only。" }
