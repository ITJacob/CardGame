        "echo_last_skill": { "zh": "回响上一技能", "brief": "按比例重放上一个技能的效果", "detail": "potency × rounding(ceil/floor/round)。权柄技能不可被重放。" },
        "gauge_shuffle": { "zh": "行动条重排", "brief": "重排场上单位的行动条进度", "detail": "resource 固定 gauge.current。" },
