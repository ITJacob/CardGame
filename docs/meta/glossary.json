        "heal": { "zh": "治疗", "brief": "恢复目标生命", "detail": "治疗一律走 heal，不混 modify_resource（A22）。mode: setHp/hpMaxRatio/to_ratio。" },
        "mount_status": { "zh": "挂载状态", "brief": "给目标施加一个状态实例", "detail": "字段 statusId/duration/stacks/stackMode/charges。落空/阻挡语义一律用 charges 次数型确定性写法（R5）。" },
        "modify_stat": { "zh": "修正属性", "brief": "直接修改单位属性值", "detail": "无宿主、不可驱散；要可见/可驱散的修正用 mount_status。mode: delta/set/mul/to_at_least/to_at_most。" },
