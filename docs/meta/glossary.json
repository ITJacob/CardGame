        "write_rule_slot": { "zh": "写入规则槽", "brief": "把一条规则写进战场级 Rules[3] 指定槽位", "detail": "slot(0–2) × field(trigger/punish/exemptions/scope)。服务仲裁人律令轴。" },
        "modify_rule_slot": { "zh": "修改规则槽", "brief": "改写/追加/移除既有槽位规则", "detail": "mode: replace/append/remove。服务律师与通识者的僭越轴。" },
