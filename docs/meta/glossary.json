        "move": { "zh": "位移", "brief": "改变单位在场上的位置", "detail": "7 种 op：push_back/pull_forward/swap_ally/swap_neighbor/insert_tail_cross_lane/param/charge_forward。" },
        "spawn": { "zh": "召唤", "brief": "在场上生成单位", "detail": "复活走 reviveOf 字段，不新增原语（G4）。position: tail/at_unit/original。" },
